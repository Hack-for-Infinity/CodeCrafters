{
  "manifest_version": 3,
  "name": "NeuroRead - ADHD & Dyslexia Reading Assistant",
  "version": "1.0.0",
  "description": "AI-powered reading assistant that adapts web content for ADHD and Dyslexic minds with eye-tracking, bionic reading, and focus modes",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/webgazer.js",
        "content/bionic-reading.js",
        "content/focus-mode.js",
        "content/eye-tracker.js",
        "content/auto-scroll.js",
        "content/text-to-speech.js",
        "content/word-highlight.js",
        "content/dyslexia-theme.js",
        "content/main.js"
      ],
      "css": [
        "styles/bionic-reading.css",
        "styles/focus-mode.css",
        "styles/dyslexia-theme.css",
        "styles/eye-tracker.css",
        "styles/word-highlight.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "styles/*",
        "assets/*",
        "offscreen.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
